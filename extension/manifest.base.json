{
  "manifest_version": 3,
  "name": "微翻 WeiFan",
  "version": "0.3.1",
  "description": "浏览器即时翻译：选区、划词、悬停、整段文档都能翻；密钥只留在本机。",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "permissions": ["storage", "clipboardRead", "contextMenus"],
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "翻译当前选中的文字"
    },
    "toggle-hover": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "开 / 关鼠标悬停翻译"
    },
    "open-text-page": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "打开文本翻译页"
    }
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content/whatsapp.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/core/tts.js", "src/content/pageagent.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "微翻",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  }
}
