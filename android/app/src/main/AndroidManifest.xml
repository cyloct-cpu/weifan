<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".WeiFanApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 主页：聊天列表（含配对入口） -->
        <activity
            android:name=".ChatListActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 配对页：手机号 → 8 位配对码 -->
        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:label="关联 WhatsApp" />

        <!-- 会话页：消息流 + 翻译 -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="会话"
            android:windowSoftInputMode="adjustResize" />

        <!-- 设置页保留，从聊天列表可进 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="设置" />


        <!--
            划词翻译：系统选中文字后的菜单里会出现「微翻」。
            官方约定：EXTRA_PROCESS_TEXT 是选中的文字，EXTRA_PROCESS_TEXT_READONLY 表示
            原文能不能被替换；替换的做法是 setResult(RESULT_OK) + 结果里再放一份 EXTRA_PROCESS_TEXT。
        -->
        <activity
            android:name=".TranslateActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 文档翻译：txt / md / csv / docx，本机解析，不上传 -->
        <activity
            android:name=".TranslateDocActivity"
            android:exported="false"
            android:label="@string/doc_label" />

        <!--
            无障碍服务是微翻在 Android 上唯一能"读输入框 + 改输入框"的入口。
            不 hook、不改包、不调私有 API —— 与 JevChat-Jarvis / SwiftSlate 同一路线。
        -->
        <service
            android:name=".service.WeiFanAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
