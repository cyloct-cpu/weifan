<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 视频通话发送侧：Camera2 采集 → H.264 编码。缺声明时真机直接失败
         （模拟器 appops 默认允许会掩盖这个缺失） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- R2 尾巴：跟进待办到期本地提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".WeiFanApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 待办到期提醒（AlarmManager → 本地通知，纯本地不上传） -->
        <receiver android:name=".notify.TodoAlarmReceiver" android:exported="false" />

        <!-- 主页：聊天列表（含配对入口） -->
        <activity
            android:name=".ChatListActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 配对页：手机号 → 8 位配对码 -->
        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:label="关联 WhatsApp" />

        <!-- 统一设置页 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置" />

        <!-- 会话页：消息流 + 翻译 -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="会话"
            android:windowSoftInputMode="adjustResize" />

        <!-- 设置页保留，从聊天列表可进 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="设置" />

        <!-- 账号页：按参考客户端登录页版式，承载订阅/试用状态入口 -->
        <activity
            android:name=".AccountActivity"
            android:exported="false"
            android:label="账号" />

        <!-- 客户/群详情页（对齐 WhatsApp Web 联络人资料） -->
        <activity
            android:name=".ChatInfoActivity"
            android:exported="false"
            android:label="详情" />

        <!-- 全屏媒体查看器 -->
        <activity
            android:name=".MediaViewerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:label="查看" />

        <!-- 独立 PDF 查看器（A1，对标参考 PdfViewerActivity） -->
        <activity
            android:name=".PdfViewerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:label="PDF" />

        <!-- 独立视频查看器（A2，对标参考 VideoViewerActivity） -->
        <activity
            android:name=".VideoViewerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize"
            android:label="视频" />

        <!-- 跟进待办（本地 CRM，批3-a） -->
        <activity
            android:name=".FollowupTodosActivity"
            android:exported="false"
            android:label="跟进待办" />

        <!-- 新建联系人（批3-b） -->
        <activity
            android:name=".NewContactActivity"
            android:exported="false"
            android:label="新建联系人" />

        <!-- 媒体发送前预览（批3-c） -->
        <activity
            android:name=".MediaSendPreviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="发送预览" />



        <!--
            划词翻译：系统选中文字后的菜单里会出现「WeFlip」。
            官方约定：EXTRA_PROCESS_TEXT 是选中的文字，EXTRA_PROCESS_TEXT_READONLY 表示
            原文能不能被替换；替换的做法是 setResult(RESULT_OK) + 结果里再放一份 EXTRA_PROCESS_TEXT。
        -->
        <activity
            android:name=".TranslateActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 文档翻译：txt / md / csv / docx，本机解析，不上传 -->
        <activity
            android:name=".TranslateDocActivity"
            android:exported="false"
            android:label="@string/doc_label" />

        <!--
            无障碍服务是 WeFlip 在 Android 上唯一能"读输入框 + 改输入框"的入口。
            不 hook、不改包、不调私有 API —— 与 JevChat-Jarvis / SwiftSlate 同一路线。
        -->
        <service
            android:name=".service.WeiFanAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
